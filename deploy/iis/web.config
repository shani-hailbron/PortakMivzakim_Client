<?xml version="1.0" encoding="UTF-8"?>
<!--
  PortalMivzakim_Client - RSS proxy rules for the PORTAL (host) site on IIS.

  The mivzakim micro-frontend reads Ynet / Haaretz / Israel Hayom RSS feeds. Those sites don't allow
  browser (CORS) requests, so the browser calls /rss/... on the portal and IIS forwards to the channel.

  Prerequisites (once per server):
    1. IIS modules: URL Rewrite 2.1 + Application Request Routing (ARR) 3.0.
    2. Enable the ARR proxy:
         %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/proxy /enabled:"True" /commit:apphost
    3. Allow the rules to clear these request headers:
         %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_ORIGIN']" /commit:apphost
         %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_REFERER']" /commit:apphost
         %windir%\system32\inetsrv\appcmd.exe set config -section:system.webServer/rewrite/allowedServerVariables /+"[name='HTTP_COOKIE']" /commit:apphost
    4. Outbound HTTPS from the server to www.ynet.co.il, www.haaretz.co.il, www.israelhayom.co.il.

  If the portal site already has a web.config: copy only the <rule> elements below into its
  <rewrite><rules>, ABOVE any catch-all / SPA fallback rule (otherwise that rule catches /rss/... first).

  Clearing Origin / Referer / Cookie: Ynet answers 403 when a foreign Origin is present, and the
  portal's cookies must not be sent to an external site.
  The Host header is set to the target site by ARR (proxy preserveHostHeader is false by default).

  Test:  curl -i -H "Origin: https://<portal>" https://<portal>/rss/ynet-news   -> 200 + XML starting with <rss
-->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="Mivzakim RSS - Ynet news" stopProcessing="true">
          <match url="^rss/ynet-news$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^GET$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_ORIGIN" value="" />
            <set name="HTTP_REFERER" value="" />
            <set name="HTTP_COOKIE" value="" />
          </serverVariables>
          <action type="Rewrite" url="https://www.ynet.co.il/Integration/StoryRss1854.xml" appendQueryString="false" />
        </rule>

        <rule name="Mivzakim RSS - Ynet sport" stopProcessing="true">
          <match url="^rss/ynet-sport$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^GET$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_ORIGIN" value="" />
            <set name="HTTP_REFERER" value="" />
            <set name="HTTP_COOKIE" value="" />
          </serverVariables>
          <action type="Rewrite" url="https://www.ynet.co.il/Integration/StoryRss3.xml" appendQueryString="false" />
        </rule>

        <rule name="Mivzakim RSS - Haaretz" stopProcessing="true">
          <match url="^rss/haaretz$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^GET$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_ORIGIN" value="" />
            <set name="HTTP_REFERER" value="" />
            <set name="HTTP_COOKIE" value="" />
          </serverVariables>
          <action type="Rewrite" url="https://www.haaretz.co.il/srv/rss---feedly" appendQueryString="false" />
        </rule>

        <rule name="Mivzakim RSS - Israel Hayom" stopProcessing="true">
          <match url="^rss/israelhayom$" />
          <conditions>
            <add input="{REQUEST_METHOD}" pattern="^GET$" />
          </conditions>
          <serverVariables>
            <set name="HTTP_ORIGIN" value="" />
            <set name="HTTP_REFERER" value="" />
            <set name="HTTP_COOKIE" value="" />
          </serverVariables>
          <action type="Rewrite" url="https://www.israelhayom.co.il/rss.xml" appendQueryString="false" />
        </rule>
      </rules>
    </rewrite>
  </system.webServer>
</configuration>
