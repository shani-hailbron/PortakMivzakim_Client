{
  "name": "portal-mivzakim-client",
  "version": "0.1.1",
  "description": "מיקרו־פרונט מבזקים לפורטל IPS",
  "scripts": {
    "start": "webpack serve --mode development --env sviva=local",
    "start:live": "webpack serve --mode development --live-reload --hot --env sviva=local",
    "build": "webpack --mode production --env sviva=prod",
    "build:dev": "webpack --mode production --env sviva=dev",
    "build:test": "webpack --mode production --env sviva=test",
