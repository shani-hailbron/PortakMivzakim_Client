    "serve:remote": "webpack serve --mode production --env sviva=prod"
  },
  "private": false,
  "dependencies": {
    "@fontsource/rubik": "^5.3.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  },
